@startuml C4_L4_Worker
title Customer Engagement Platform - Application: workflow engine - Code (L4)

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

package "event processing" {
  class EventsProcessor <<BullMQ worker 'events'>> {
    +process(job: ProcessEventJob): Promise<void>
  }
  class TriggerService {
    +startMatchingRuns(event: UserEvent, profile: UserProfile): Promise<void>
  }
  class WaitingRunService {
    +resumeWaitingRuns(event: UserEvent, profile: UserProfile): Promise<void>
  }
}

package "workflow execution" {
  class StepsProcessor <<BullMQ worker 'workflow-steps'>> {
    +process(job: StepJob): Promise<void>
  }
  class WorkflowRunner {
    +run(job: StepJob): Promise<void>
    +fail(job: StepJob, error: Error): Promise<void>
  }
  class StepOwnershipService {
    +findOwnedRun(job: StepJob, jobId: string): Promise<WorkflowRun | null>
  }
  class StepNodeResolver {
    +resolve(run: WorkflowRun, nodeId: string): Promise<ResolvedStep>
    +assertNextNodeExists(step: ResolvedStep, result: StepResult): void
    +findNodeType(run: WorkflowRun, nodeId: string): Promise<NodeType | null>
  }
  class StepContextBuilder {
    +build(run: WorkflowRun, job: StepJob): Promise<RunContext>
  }
  class StepRecorder {
    +recordCompleted(run, job, node, output: RunStepOutput): Promise<RunStep | null>
    +recordFailed(run, job, nodeType, error: Error): Promise<boolean>
  }
  class FollowUpScheduler {
    +schedule(step: RunStep): Promise<void>
  }
  class "run-transition" as RunTransition <<functions>> {
    +toStepOutput(result: StepResult, now: Date): RunStepOutput
    +applyStepOutput(run, job, output, now): void
  }
  class StepExecutorRegistry {
    +register(executor: StepExecutor): void
    +get(nodeType: NodeType): StepExecutor
  }
  interface StepExecutor {
    +nodeType: NodeType
    +execute(node: WorkflowNode, ctx: StepExecutionContext): Promise<StepResult>
  }
  class BranchStepExecutor
  class DelayStepExecutor
  class WaitForEventStepExecutor
  class SendEmailStepExecutor
  class ExitStepExecutor
}

package "messaging" {
  class EmailSendProcessor <<BullMQ worker 'email-send'>> {
    +process(job: EmailSendJob): Promise<void>
  }
  class EmailService {
    +send(messageId: string, attempt: number): Promise<void>
  }
  class TemplateRenderer {
    +render(template: Template, to: string, variables: RunContext, idempotencyKey: string): RenderedEmail
  }
  interface EmailProvider {
    +send(email: RenderedEmail): Promise<SendResult>
  }
  class ResendEmailProvider
  class LogEmailProvider
}

note right of EmailService
  queued -> sending -> sent | failed; queued -> skipped | failed.
  Claimed before the provider call. A definitive rejection
  releases the message for retry; an unknown outcome ends as
  failed/send_interrupted (at most once).
end note

package "shared" {
  class ConditionEvaluator {
    +evaluate(condition: Condition, ctx: RunContext): boolean
  }
  class QueueProducer {
    +enqueueProcessEvent(job: ProcessEventJob): Promise<void>
    +enqueueStep(job: StepJob, delayMs?: number): Promise<void>
    +enqueueEmail(job: EmailSendJob): Promise<void>
  }
  abstract class "AbstractRepository<T>" as AbstractRepository {
    +transaction(work: (tx) => Promise<R>): Promise<R>
    +find(options, tx?): Promise<T[]>
    +findOne(options, tx?): Promise<T | null>
    +findById(id: string, tx?): Promise<T | null>
    +findByIdOrFail(id: string, tx?): Promise<T>
    +save(entity, tx?): Promise<T>
  }
  class WorkflowRepository {
    +findActiveByTrigger(accountId: string, eventName: string): Promise<WorkflowVersion[]>
    +getVersion(versionId: string): Promise<WorkflowVersion>
    +getVersions(versionIds: string[]): Promise<Map<string, WorkflowVersion>>
  }
  class RunRepository {
    +createIfAbsent(run: object): Promise<WorkflowRun | null>
    +findById(runId: string): Promise<WorkflowRun>
    +findWaiting(accountId: string, profileId: string, eventName: string, eventId: string): Promise<WorkflowRun[]>
    +claim(runId: string, nodeId: string, claimKey: string): Promise<boolean>
    +saveTransition(run: WorkflowRun, fromNodeId: string, tx?): Promise<boolean>
    +markFailed(runId: string, nodeId: string, error: string, tx?): Promise<boolean>
    +save(run: WorkflowRun): Promise<void>
  }
  class RunStepRepository {
    +create(step: object, tx?): Promise<RunStep>
    +createIfAbsent(step: object, tx?): Promise<void>
    +findByJobId(jobId: string, tx?): Promise<RunStep | null>
    +findByRunId(runId: string, tx?): Promise<RunStep[]>
  }
  class ProfileRepository {
    +findById(profileId: string): Promise<UserProfile>
  }
  class EventRepository {
    +findById(eventId: string): Promise<UserEvent>
  }
  class MessageRepository {
    +createIfAbsent(message: object, tx?): Promise<{ message, created }>
    +claimForSending(id: string, tx?): Promise<boolean>
    +releaseSending(id: string, tx?): Promise<void>
    +markSent(id: string, providerMessageId: string, subject: string, attempts: number, tx?): Promise<void>
    +markFailed(id: string, error: string, attempts: number, tx?): Promise<void>
    +markSkipped(id: string, reason: string, attempts: number, tx?): Promise<void>
    +findByRunId(runId: string, tx?): Promise<Message[]>
  }
  class TemplateRepository {
    +findById(id: string, tx?): Promise<Template | null>
  }
}

class Redis <<BullMQ / Redis>>
class Database <<PostgreSQL>>
class EmailDeliveryProvider <<external API>>

' ---- event processing ----
Redis --> EventsProcessor : process-event jobs
EventsProcessor --> EventRepository : load event
EventsProcessor --> ProfileRepository : load profile
EventsProcessor --> TriggerService : new event
EventsProcessor --> WaitingRunService : new event
TriggerService --> WorkflowRepository : find workflows by trigger
TriggerService --> ConditionEvaluator : check entry filter
TriggerService --> RunRepository : create run
TriggerService --> QueueProducer : enqueue first step
WaitingRunService --> RunRepository : find + claim waiting runs
WaitingRunService --> QueueProducer : enqueue next step

' ---- workflow execution ----
Redis --> StepsProcessor : step jobs (incl. delayed)
StepsProcessor --> WorkflowRunner
WorkflowRunner --> StepOwnershipService : does this job own the run?
WorkflowRunner --> StepNodeResolver : node + executor
WorkflowRunner --> StepContextBuilder : run context
WorkflowRunner --> StepExecutor : execute node
WorkflowRunner --> StepRecorder : record completed / failed step
WorkflowRunner --> FollowUpScheduler : next job
WorkflowRunner --> RunStepRepository : already recorded?
StepOwnershipService --> RunRepository : load / claim run
StepNodeResolver --> WorkflowRepository : load version graph
StepNodeResolver --> StepExecutorRegistry : executor for node type
StepContextBuilder --> ProfileRepository : profile
StepContextBuilder --> EventRepository : event that last touched the run
StepRecorder --> RunStepRepository : step row
StepRecorder --> RunRepository : guarded save transition / mark failed
StepRecorder --> RunTransition : apply result to run
FollowUpScheduler --> QueueProducer : next step / delayed step / wait timeout
StepExecutorRegistry --> StepExecutor
StepExecutor <|.. BranchStepExecutor
StepExecutor <|.. DelayStepExecutor
StepExecutor <|.. WaitForEventStepExecutor
StepExecutor <|.. SendEmailStepExecutor
StepExecutor <|.. ExitStepExecutor
BranchStepExecutor --> ConditionEvaluator
SendEmailStepExecutor --> MessageRepository : create message (idempotent per run+node)
SendEmailStepExecutor --> QueueProducer : email job

' ---- messaging ----
Redis --> EmailSendProcessor : email-send jobs (retries)
EmailSendProcessor --> EmailService
EmailSendProcessor --> MessageRepository : failed (final attempt)
EmailService --> ProfileRepository : unsubscribed?
EmailService --> TemplateRepository : template
EmailService --> TemplateRenderer
EmailService --> EmailProvider
EmailService --> MessageRepository : claim / sent / failed / skipped
EmailProvider <|.. ResendEmailProvider
EmailProvider <|.. LogEmailProvider
ResendEmailProvider --> EmailDeliveryProvider : HTTPS API

' ---- infrastructure ----
QueueProducer -[norank]-> Redis : queue.add()
WorkflowRepository --> Database
RunRepository --> Database
RunStepRepository --> Database
ProfileRepository --> Database
EventRepository --> Database
MessageRepository --> Database
TemplateRepository --> Database
AbstractRepository <|-- WorkflowRepository
AbstractRepository <|-- RunRepository
AbstractRepository <|-- RunStepRepository
AbstractRepository <|-- ProfileRepository
AbstractRepository <|-- EventRepository
AbstractRepository <|-- MessageRepository
AbstractRepository <|-- TemplateRepository

note bottom of AbstractRepository
  Every repository method takes an optional
  transaction (tx); without it the call runs
  on the default connection.
end note

note right of RunRepository
  claim() is an atomic conditional update keyed by
  the step job id (claimKey): only one of
  "event arrived" / "timeout" can continue a waiting
  run, and a retried job can re-win its own claim.
end note

note right of WorkflowRunner
  One job per node visit. run_steps.job_id makes execution
  idempotent; deterministic job ids make the follow-up enqueue
  idempotent. Transient errors are retried and then left for
  job.retry(); UnrecoverableError fails the run.
end note

note right of StepsProcessor
  StepJob = { runId, nodeId, cause: enter | event | timeout, eventId? }
  jobId = runId__nodeId__cause[__eventId]
end note


' ---- layout hints ----
StepsProcessor -[hidden]l- EventsProcessor
EmailSendProcessor -[hidden]l- StepsProcessor
@enduml