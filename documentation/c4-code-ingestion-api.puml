@startuml

title Customer Engagement Platform - Ingestion API - Code (L4)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Database <<PostgreSQL>> {
  +query(sql: string): Promise<object[]>
}

class Redis <<BullMQ / Redis>> {
  +set(key: string, value: string, NX, EX): Promise<string | null>
  +del(key: string): Promise<void>
}

package "Public Ingestion API" {
  class IngestionController {
    +identify(dto: IdentifyDto): Promise<IngestionResult>
    +track(dto: TrackDto): Promise<IngestionResult>
  }

  class ApiKeyGuard {
    +canActivate(context): boolean
  }

  class ValidationPipe <<NestJS>> {
    +transform(dto): IdentifyDto | TrackDto
  }

  class IngestionService {
    +identify(dto: IdentifyDto): Promise<IngestionResult>
    +track(dto: TrackDto): Promise<IngestionResult>
  }

  class IdempotencyService {
    +claim(accountId: string, messageId: string): Promise<boolean>
    +release(accountId: string, messageId: string): Promise<void>
  }

  class ProfileRepository {
    +upsert(profile: UpsertProfileInput, tx?): Promise<string>
    +findById(profileId: string, tx?): Promise<Profile | null>
  }

  class EventRepository {
    +findByMessageId(accountId: string, messageId: string, tx?): Promise<UserEvent | null>
    +createIfAbsent(event: CreateEventInput, tx?): Promise<string | null>
  }

  class EventOutboxRepository {
    +add(eventId: string, tx?): Promise<void>
    +findPending(limit: number): Promise<EventOutbox[]>
    +removeByEventId(eventId: string): Promise<void>
  }

  class OutboxService {
    +publishPending(): Promise<void>
  }

  class QueueProducer {
    +enqueueProcessEvent(job: ProcessEventJob): Promise<void>
  }

  IngestionController --> ApiKeyGuard
  IngestionController --> ValidationPipe
  IngestionController --> IngestionService
  IngestionService --> IdempotencyService
  IngestionService --> ProfileRepository
  IngestionService --> EventRepository
  IngestionService --> EventOutboxRepository : add / remove
  IngestionService --> QueueProducer
  OutboxService --> EventOutboxRepository
  OutboxService --> QueueProducer
  IdempotencyService --> Redis
  ProfileRepository --> Database
  EventRepository --> Database
  EventOutboxRepository --> Database
  QueueProducer --> Redis : queue.add("process-event")
}

note right of IngestionService
  POST /api/v1/identify
  POST /api/v1/track

  Validate -> dedupe (claim messageId) ->
  persist profile + event + outbox row
  in one transaction -> enqueue process-event ->
  delete the outbox row (best effort).
  Failure releases the claim (client may retry).
end note

note bottom of OutboxService
  Every 5 s re-adds process-event for outbox rows
  (deterministic jobId, so no duplicates) and deletes
  them; covers a crash between commit and enqueue.
end note

@enduml
