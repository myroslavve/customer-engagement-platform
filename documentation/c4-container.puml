@startuml C4_L2_Container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
title Customer Engagement Platform - C4 Container (L2)

Person(marketer, "Marketing manager", "Creates templates, audiences and workflows; reviews activity.")
Person(enduser, "End user", "Uses the product and receives campaign emails.")

System_Ext(product, "Customer Product", "Its backend calls identify/track on user actions.")
System_Ext(email, "Email Delivery Provider", "Resend / SendGrid / AWS SES sandbox.")

System_Boundary(cep, "Customer Engagement Platform") {
  Container(adminUi, "Admin UI", "React SPA", "Template editor, audience rules, workflow builder, activity log.")
  Container(app, "Application", "Node.js, NestJS (monolith, single process)", "HTTP API: public ingestion (/api/v1/identify, /api/v1/track, API-key auth) and admin API (templates, segments, workflows, activity). Persists events and enqueues jobs. In the same process, BullMQ queue processors match triggers, run workflow steps (branch, delay, wait-for-event, send, exit), render and send emails with retries.")
  ContainerDb(pg, "Database", "PostgreSQL", "Source of truth: accounts, API keys, profiles, events, templates, segments, workflow versions, workflow runs, run steps, message log.")
  ContainerDb(redis, "Redis", "Redis", "BullMQ queues (events, workflow-steps, email-send) incl. delayed jobs; idempotency keys; rate limiting.")
}

Rel(marketer, adminUi, "Uses", "HTTPS")
Rel(adminUi, app, "Admin API calls", "REST/JSON, JWT")

Rel(enduser, product, "Uses")
Rel(product, app, "POST identify / track", "REST/JSON, API key")
Rel(app, product, "202 Accepted + eventId / 4xx", "REST/JSON")

Rel(app, pg, "Reads/writes events, profiles, workflows, runs, steps, message log", "SQL")
Rel(app, redis, "Enqueues and consumes jobs; schedules delayed jobs (delays, wait timeouts); idempotency keys", "BullMQ")
Rel(app, email, "Sends email; gets sent/failed", "HTTPS API")
Rel(email, enduser, "Delivers campaign email", "Email")

SHOW_LEGEND()
@enduml