{
  "name": "customer-engagement-platform",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "nest build",
    "start:worker": "nest start",
    "start:worker:dev": "nest start --watch",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "enqueue:event": "ts-node scripts/enqueue-event.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "start:worker:prod": "node dist/main.worker.js",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myroslavve/customer-engagement-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/myroslavve/customer-engagement-platform/issues"
  },
  "homepage": "https://github.com/myroslavve/customer-engagement-platform#readme",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
