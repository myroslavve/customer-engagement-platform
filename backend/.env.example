# server.config.ts
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# db.config.ts
DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=cep
DB_PASSWORD=cep
DB_NAME=cep
DB_LOGGING=false
DB_SSL=false

# redis.config.ts
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_DB=0

# queue.config.ts
EVENTS_QUEUE_CONCURRENCY=10

# ingestion.config.ts (account id: a row in accounts, see README)
INGESTION_API_KEY=replace-with-a-local-api-key
INGESTION_ACCOUNT_ID=replace-with-an-accounts-uuid

# auth.config.ts
JWT_SECRET=replace-with-a-local-jwt-secret
# Migration-only first-admin bootstrap. Set these before npm run migration:run.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_ACCOUNT_NAME=local
