# Integration tests (npm run test:integration). Placeholders only, no secrets; shell variables win
# (CI sets hosts and ports). Database and Redis db are separate from the dev ones in .env.

# server.config.ts
NODE_ENV=test
LOG_LEVEL=warn

# db.config.ts
DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=cep
DB_PASSWORD=cep
DB_NAME=cep_test

# redis.config.ts
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_DB=1

# queue.config.ts (short backoff so exhausted retries finish in milliseconds)
EVENTS_QUEUE_CONCURRENCY=2
STEPS_QUEUE_CONCURRENCY=2
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=20

# ingestion.config.ts
INGESTION_API_KEY=test-api-key
INGESTION_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# auth.config.ts (ADMIN_* unset: the AdminApi migration seeds nothing)
JWT_SECRET=test-jwt-secret

# email.config.ts (the provider is replaced by a fake in tests)
RESEND_API_KEY=test-resend-api-key
EMAIL_FROM=test@example.com
EMAIL_QUEUE_CONCURRENCY=2
